<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.scaccogatto.sogno.warmup</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>/Users/gatto/Developer/scaccogatto/sogno/sogno</string>
    <string>warmup</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>@HOUR@</integer>
    <key>Minute</key><integer>@MINUTE@</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/gatto/.claude/dream/warmup.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/gatto/.claude/dream/warmup-err.log</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
